# =============================================
# Warehouse Management System — Environment Config
# =============================================
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=mysql+pymysql://root@localhost/warehouse_db

# --- Auth / Security ---
SECRET_KEY=supersecret_warehouse_key_12345!@#$
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360

# --- Telegram Bot Notifications ---
# Get your bot token from https://t.me/BotFather
# Get your Chat ID: message @userinfobot or use the getUpdates API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
